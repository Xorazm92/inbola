PAYLOAD_SECRET=SOME_RANDOM_STRING
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3000
MONGODB_URL=mongodb://username:password@0.0.0.0:27017/?retryWrites=true&w=majority
RESEND_API_KEY=re_API_KEY

STRIPE_SECRET_KEY=sk_test_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_WEBHOOK_SECRET

S3_BUCKET_NAME=bucket_name
S3_BUCKET_REGION=region
S3_ACCESS_KEY=access_key
S3_SECRET_ACCESS_KEY=secret_access_key
# Database
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Payload CMS
PAYLOAD_SECRET=your-super-secret-key
NEXT_PUBLIC_SERVER_URL=https://your-domain.replit.app

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=info@yourdomain.com
EMAIL_NAME=Your App Name
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
RESEND_API_KEY=re_your_resend_api_key

# File Storage (Optional)
S3_BUCKET_NAME=your-bucket-name
S3_BUCKET_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# Production
NODE_ENV=production
SENTRY_DSN=your-sentry-dsn
