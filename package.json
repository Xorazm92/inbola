{
  "name": "inbola.uz",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "gen:types": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "dev:app": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts nodemon",
    "dev:db": "docker-compose up -d",
    "dev": "npm run dev:app",
    "seed": "ts-node -O '{\"jsx\":\"react\"}' scripts/seed.ts",
    "seed-simple": "ts-node -O '{\"jsx\":\"react\"}' scripts/seed-simple.ts",
    "seed-hash": "ts-node -O '{\"jsx\":\"react\"}' scripts/seed-hash.ts",
    "start:dev": "npm run dev",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png}\" dist/ && copyfiles next.config.js dist/",
    "build:payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:next": "cross-env PAYLOAD_CONFIG_PATH=dist/payload.config.js NEXT_BUILD=true node dist/server.js",
    "build": "cross-env NODE_ENV=production npm run build:payload && npm run build:server && npm run copyfiles && npm run build:next",
    "start": "cross-env PAYLOAD_CONFIG_PATH=dist/payload.config.js NODE_ENV=production node dist/server.js",
    "create-admin": "ts-node -O '{\"jsx\":\"react\"}' scripts/create-admin.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "pr:precheck": "npm run lint && npm run gen:types && npm run type-check && npm run build"
  },
  "resolutions": {
    "cliui": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-storage": "^3.689.0",
    "@hookform/resolvers": "^3.10.0",
    "@next/bundle-analyzer": "^15.3.4",
    "@payloadcms/bundler-webpack": "^1.0.6",
    "@payloadcms/db-mongodb": "^1.7.3",
    "@payloadcms/plugin-cloud-storage": "^1.2.0",
    "@payloadcms/richtext-slate": "^1.4.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@react-email/components": "^0.0.22",
    "@sentry/nextjs": "^9.34.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tanstack/react-query": "^4.36.1",
    "@trpc/client": "^10.44.1",
    "@trpc/next": "^10.44.1",
    "@trpc/react-query": "^10.44.1",
    "@trpc/server": "^10.44.1",
    "aws-crt": "^1.24.2",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "browserify-zlib": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "gtag": "^1.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.441.0",
    "mongodb": "^6.17.0",
    "next": "14.2.5",
    "next-intl": "^4.3.1",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.3.0",
    "nodemailer": "^6.9.16",
    "os-browserify": "^0.3.0",
    "payload": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-intersection-observer": "^9.16.0",
    "resend": "^4.0.1",
    "sharp": "^0.34.2",
    "sonner": "^1.7.1",
    "stream-browserify": "^3.0.0",
    "stripe": "^17.5.0",
    "swiper": "^11.2.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "workbox-webpack-plugin": "^7.3.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/mongodb-memory-server": "^1.8.0",
    "@types/node": "^22.15.34",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "postcss": "^8",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
